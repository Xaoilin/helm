# ── Developer Configuration ──
# Copy this file to .env and fill in your values.
# VITE values are public in the browser bundle. Never put provider secrets here.

# Supabase (required for online persistence + Google Sign-In)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Spring Boot prayer-service URL (public URL; no credentials in the browser)
VITE_PRAYER_API_BASE_URL=http://localhost:8080
VITE_PROFILE_API_BASE_URL=http://localhost:8080
# Optional Spring Boot planner-service URL (tasks, habits, goals, XP, daily momentum, the clock)
VITE_PLANNER_API_BASE_URL=http://localhost:8080
# Optional Spring Boot finance-service URL (accounts, transactions, budgets, savings goals, banking review, equity)
VITE_FINANCE_API_BASE_URL=http://localhost:8085

# Google OAuth (required for Google Calendar integration)
VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
# The calendar service holds the Google OAuth client secret and users' refresh tokens.
