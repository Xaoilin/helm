# ── Developer Configuration ──
# Copy this file to .env and fill in your values.
# These are baked into the build — end users never see or configure them.

# Supabase (required for online persistence + Google Sign-In)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth (required for Google Calendar integration)
VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
# Optional override for the hosted Google Calendar OAuth Edge Function name
VITE_GOOGLE_CALENDAR_OAUTH_FUNCTION=google-calendar-oauth

# ElevenLabs (optional - for voice assistant with cloned voice)
VITE_ELEVENLABS_API_KEY=xi-xxxxxxxxxxxxxxxx
VITE_ELEVENLABS_VOICE_ID=your-voice-id

# Hosted assistant web defaults (safe to expose in the client build)
# GitHub Pages should set these so the website uses hosted GPT-5.4 by default.
VITE_DEFAULT_ASSISTANT_PROVIDER=hosted
VITE_HOSTED_ASSISTANT_FUNCTION=assistant-openai
VITE_HOSTED_ASSISTANT_BILLING_FUNCTION=assistant-openai-billing
VITE_HOSTED_ASSISTANT_MODEL=gpt-5.4

# Monzo (optional - for bank transaction import)
# Get your token from https://developers.monzo.com/
VITE_MONZO_ACCESS_TOKEN=your-monzo-access-token

# Local eval scripts only (not bundled into the web build)
# Use these for `npm run llm-compare` when comparing hosted models locally.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.4
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase Edge Function secrets (set in Supabase, not in the Vite client build)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5.4
# OPENAI_ADMIN_KEY=sk-admin-xxxxxxxxxxxxxxxx
# OPENAI_PROJECT_ID=proj_xxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# GOOGLE_OAUTH_ALLOWED_ORIGINS=http://localhost:5174,https://xaoilin.github.io
