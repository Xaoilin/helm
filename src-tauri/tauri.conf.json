{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HELM",
  "version": "0.2.74",
  "identifier": "com.helm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HELM",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "font-src": "'self' data:",
        "frame-src": "https://accounts.google.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' blob: data:",
        "script-src": "'self' https://accounts.google.com",
        "style-src": "'self' 'unsafe-inline' https://accounts.google.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
