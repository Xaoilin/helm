{
  "name": "helm",
  "private": true,
  "version": "0.2.114",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "agent:fast": "node ./scripts/run-agent-fast.mjs",
    "agent:local-gate": "npm run agent:fast",
    "agent:policy": "npm run version:check && node ./scripts/verify-agent-policy.mjs",
    "benchmark:assistant": "tsx ./scripts/run-assistant-benchmark.ts",
    "build": "npm run build:web",
    "build:web": "vite build && node ./scripts/copy-spa-fallback.mjs",
    "check": "node ./scripts/run-check.mjs",
    "database:precutover": "node ./scripts/reconcile-helm-migration-history.mjs",
    "database:verify": "node ./scripts/verify-helm-database.mjs",
    "database:wait": "node ./scripts/wait-for-helm-database.mjs",
    "dev": "vite",
    "handoff:check": "node ./scripts/verify-handoff.mjs",
    "hooks:install": "node ./scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "lint:changed": "eslint --no-warn-ignored",
    "llm-compare": "node ./scripts/compare-assistant-models.mjs",
    "postversion": "npm run version:sync",
    "preview": "vite preview",
    "release:check": "npm run check && npm run benchmark:assistant -- --provider hosted --enforce",
    "test": "vitest run",
    "test:database": "node ./scripts/test-helm-database.mjs",
    "test:e2e": "node ./scripts/run-playwright.mjs blocking",
    "test:e2e:smoke": "node ./scripts/run-playwright.mjs smoke",
    "test:e2e:ui": "node ./scripts/run-playwright.mjs blocking --ui",
    "test:e2e:visual": "node ./scripts/run-playwright.mjs visual",
    "test:related": "vitest related --run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --incremental --noEmit && tsc -p tsconfig.node.json --incremental --noEmit",
    "version:check": "node ./scripts/sync-version.mjs --check",
    "version:sync": "node ./scripts/sync-version.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@supabase/supabase-js": "^2.100.1",
    "openwakeword-wasm-browser": "^0.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "supabase": "2.111.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
