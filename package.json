{
  "name": "helm",
  "private": true,
  "version": "0.2.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "handoff:check": "node ./scripts/verify-handoff.mjs",
    "lint": "eslint .",
    "llm-compare": "node ./scripts/compare-assistant-models.mjs",
    "postversion": "npm run version:sync",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "version:sync": "node ./scripts/sync-version.mjs",
    "version:check": "node ./scripts/sync-version.mjs --check",
    "check": "npm run version:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@tauri-apps/api": "^2.10.1",
    "openwakeword-wasm-browser": "^0.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
