                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "lender": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "repaid",
                      "closed"
                    ]
                  },
                  "monthlyPaymentPence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
