                            "type": "null"
                          }
                        ]
                      },
                      "sourceIds": {
                        "anyOf": [
                          {
                            "maxItems": 100,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "bank",
                          "user"
                        ]
                      }
                    },
                    "required": [
