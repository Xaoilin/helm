                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "amountPence": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "note": {
                        "type": "string",
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "label",
                      "amountPence",
                      "note"
                    ],
                    "additionalProperties": false
                  }
                },
                "workCostsPence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "workCostsNote": {
                  "type": "string",
                  "maxLength": 4000
                },
                "scenarios": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
