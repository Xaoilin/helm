    "title": "Add Sabah One Employment Evidence",
    "description": "Append a concise sourced recruiting update without changing status or inventing a date. Include the email/job evidence URL when available; repeated history IDs or evidence URLs are deduplicated.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "Required idempotency key. Reuse the same UUID and exact input when retrying a write; use a new UUID for new evidence."
        },
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "history": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "type": "string",
              "enum": [
                "application",
                "contact",
                "document",
                "remote_evidence",
                "note"
              ]
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "description": "Confirmed local calendar date, YYYY-MM-DD. Omit when the source does not supply a date."
            },
            "summary": {
              "type": "string",
              "minLength": 1,
