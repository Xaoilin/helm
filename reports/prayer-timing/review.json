  "criteria": {
    "craft": {
      "verdict": "pass",
      "evidence": "Ten full-size browser images inspected. Three dialog choices maintain aligned icon, copy and 12/8/2 point columns. Saved Prompt \u00b712, Within \u00b78 and Outside \u00b72 labels remain visible in the narrow 320px prayer timeline and orderly at 1440px."
    },
    "coherence": {
      "verdict": "pass",
      "evidence": "Dark navy cards, subtle border colours and compact typography match the existing Night Compass reference. Screenshots named dark and light show the same fixed dark product treatment; they do not prove distinct themes."
    },
    "hierarchy": {
      "verdict": "pass",
      "evidence": "The timing dialog presents three explicit actions with prominent point totals and explanatory copy. Challenge score captions and 12-of-12/8-of-12 point labels distinguish 100%/67% scores from each participant\u2019s separate 100% complete line."
    },
    "stateMotion": {
      "verdict": "pass",
      "evidence": "The within-window focus outline is visible in the 320px dialog. All three saved outcomes show retained status labels. The held-refresh render retains score numbers and record rather than loading placeholders. No new motion requires a clip; temporal refresh correctness belongs to the functional browser test."
    },
    "actualSize": {
      "verdict": "pass",
      "evidence": "Inspected dialogs and saved timeline in context at 1440\u00d7950 and 320\u00d7950 under both stored preferences. Choice copy wraps without clipping. Compact saved labels remain legible and the timeline line stays above prayer labels. The held-refresh screenshot at phone width preserves the score/points/completion hierarchy."
    },
    "rejectionRegression": {
      "verdict": "pass",
      "evidence": "Current ledger cases VA-001/002 concern mouse icons and do not apply. The compact timing labels avoid the cropped long labels found in the sibling Lina Opal review. The Sabah timeline line remains separated from the labels in the reviewed 320px image."
    }
  },
